{
  "model": "fable",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(flutter --version)",
      "Bash(flutter doctor *)",
      "Bash(flutter devices *)",
      "Bash(flutter create *)",
      "Bash(flutter pub *)",
      "Bash(flutter analyze *)",
      "Bash(flutter test *)",
      "Bash(flutter build *)",
      "Bash(flutter run *)",
      "Bash(flutter clean *)",
      "Bash(dart --version)",
      "Bash(dart format *)",
      "Bash(dart analyze *)",
      "Bash(dart fix *)",
      "Bash(dart test *)",
      "Bash(dart pub *)",
      "Bash(dart run build_runner *)",
      "Bash(dart run tool/*)",
      "Bash(python tool/oraculo/oraculo.py *)",
      "Bash(python3 tool/oraculo/oraculo.py *)",
      "Bash(git init *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git tag *)",
      "Bash(git branch *)",
      "Bash(git restore *)",
      "Bash(git mv *)",
      "PowerShell(flutter --version)",
      "PowerShell(flutter doctor *)",
      "PowerShell(flutter devices *)",
      "PowerShell(flutter create *)",
      "PowerShell(flutter pub *)",
      "PowerShell(flutter analyze *)",
      "PowerShell(flutter test *)",
      "PowerShell(flutter build *)",
      "PowerShell(flutter run *)",
      "PowerShell(flutter clean *)",
      "PowerShell(dart --version)",
      "PowerShell(dart format *)",
      "PowerShell(dart analyze *)",
      "PowerShell(dart fix *)",
      "PowerShell(dart test *)",
      "PowerShell(dart pub *)",
      "PowerShell(dart run build_runner *)",
      "PowerShell(dart run tool/*)",
      "PowerShell(python tool/oraculo/oraculo.py *)",
      "PowerShell(git init *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git tag *)",
      "PowerShell(git branch *)",
      "PowerShell(git restore *)",
      "PowerShell(git mv *)",
      "WebSearch",
      "WebFetch(domain:pub.dev)",
      "WebFetch(domain:docs.flutter.dev)",
      "WebFetch(domain:api.flutter.dev)",
      "WebFetch(domain:dart.dev)",
      "WebFetch(domain:api.dart.dev)",
      "WebFetch(domain:drift.simonbinder.eu)",
      "WebFetch(domain:threejs.org)",
      "WebFetch(domain:docs.blender.org)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:platform.claude.com)",
      "WebFetch(domain:code.claude.com)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git clean *)",
      "PowerShell(git push *)",
      "PowerShell(git clean *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/key.properties)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(flutter pub publish *)",
      "Bash(dart pub publish *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(flutter pub publish *)",
      "PowerShell(dart pub publish *)"
    ]
  }
}
